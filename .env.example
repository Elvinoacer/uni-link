# ============================================
# Environment Configuration
# Copy this to .env.local and fill in values
# ============================================

# Node Environment
NODE_ENV=development

# API Gateway
GATEWAY_PORT=3000
GATEWAY_HOST=localhost

# Service Ports
USER_SERVICE_PORT=3001
POST_SERVICE_PORT=3002
TIMELINE_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
MARKETPLACE_SERVICE_PORT=3005
EVENT_SERVICE_PORT=3006
LOSTFOUND_SERVICE_PORT=3007
SEARCH_SERVICE_PORT=3008
CHAT_SERVICE_PORT=3009
MODERATION_SERVICE_PORT=3010

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=unisocial
POSTGRES_PASSWORD=unisocial_dev
POSTGRES_DB=unisocial
DATABASE_URL=postgresql://unisocial:unisocial_dev@localhost:5432/unisocial

# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=unisocial
MONGODB_PASSWORD=unisocial_dev
MONGODB_DATABASE=unisocial
MONGODB_URI=mongodb://unisocial:unisocial_dev@localhost:27017/unisocial?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Neo4j
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=unisocial_dev
NEO4J_URI=bolt://localhost:7687

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=unisocial
RABBITMQ_PASSWORD=unisocial_dev
RABBITMQ_URL=amqp://unisocial:unisocial_dev@localhost:5672

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Media Storage (S3 or Cloudinary)
STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=uni-social-media

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Push Notifications
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# External APIs
# OPENLIBRARY_API_URL=https://openlibrary.org/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
