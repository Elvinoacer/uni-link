generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  email         String         @unique
  passwordHash  String         @map("password_hash")
  displayName   String?        @map("display_name")
  bio           String?
  avatarUrl     String?        @map("avatar_url")
  bannerUrl     String?        @map("banner_url")
  isVerified    Boolean        @default(false) @map("is_verified")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  refreshTokens RefreshToken[]
  pushTokens    PushToken[]
  listings      Listing[]
  lostFoundItems LostFoundItem[]
  events        Event[]
  eventRsvps    EventRsvp[]
  followers     Follow[]       @relation("Following")
  following     Follow[]       @relation("Follower")
  posts         Post[]
  notifications Notification[]
  reports       Report[]       @relation("Reporter")
  messages      Message[]
  listingFavorites ListingFavorite[]
  listingBookmarks ListingBookmark[]

  role          String         @default("USER") // 'USER', 'ADMIN', 'MODERATOR'
  isBanned      Boolean        @default(false) @map("is_banned")
  isShadowbanned Boolean       @default(false) @map("is_shadowbanned")

  stories       Story[]
  storyViews    StoryView[]
  storyLikes    StoryLike[] @relation("StoryLikes")

  // Community relations
  communityOwned     Community[]       @relation("CommunityOwner")
  communityFollows   CommunityFollow[]
  communityPosts     CommunityPost[]   @relation("CommunityPostAuthor")
  communityPostLikes CommunityPostLike[]

  galleryItems       GalleryItem[]
  portfolio          Portfolio?

  // Resource management
  resources          Resource[]
  resourceUpvotes    ResourceUpvote[]
  resourceComments   ResourceComment[]

  @@map("users")
}

// Portfolio Feature
model Portfolio {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  headline           String?  // Short professional summary
  bio                String?  @db.Text // Long-form description
  roleTitle          String?  @map("role_title") // e.g., Full Stack Developer
  location           String?
  timezone           String?
  yearsOfExperience  Int?     @map("years_of_experience")
  resumeUrl          String?  @map("resume_url")
  portfolioUrl       String?  @map("portfolio_url") // External portfolio link
  availabilityStatus String   @default("open_to_work") @map("availability_status") // available, busy, open_to_work
  skills             String[] @default([])
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       PortfolioProject[]
  experiences    PortfolioExperience[]
  education      PortfolioEducation[]
  certifications PortfolioCertification[]

  @@map("portfolios")
}

model PortfolioProject {
  id          String   @id @default(uuid())
  portfolioId String   @map("portfolio_id")
  title       String
  description String?  @db.Text
  url         String?
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("portfolio_projects")
}

model PortfolioExperience {
  id          String    @id @default(uuid())
  portfolioId String    @map("portfolio_id")
  company     String
  title       String
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date") // Null if current
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("portfolio_experiences")
}

model PortfolioEducation {
  id          String    @id @default(uuid())
  portfolioId String    @map("portfolio_id")
  institution String
  degree      String?
  field       String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("portfolio_education")
}

model PortfolioCertification {
  id          String    @id @default(uuid())
  portfolioId String    @map("portfolio_id")
  name        String
  issuer      String?
  issueDate   DateTime? @map("issue_date")
  url         String?
  createdAt   DateTime  @default(now()) @map("created_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("portfolio_certifications")
}

model GalleryItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gallery_items")
}

model Story {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  mediaUrl  String   @map("media_url")
  mediaType String   @map("media_type") // 'image' | 'video'
  caption   String?  // Text caption
  expiresAt DateTime @map("expires_at")
  viewCount Int      @default(0) @map("view_count")
  createdAt DateTime @default(now()) @map("created_at")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views     StoryView[]
  likes     StoryLike[]

  @@index([userId])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String   @map("story_id")
  viewerId  String   @map("viewer_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@map("story_views")
}

model StoryLike {
  id        String   @id @default(uuid())
  storyId   String   @map("story_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation("StoryLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("story_likes")
}

// ... existing models ...

model Report {
  id          String   @id @default(uuid())
  reporterId  String   @map("reporter_id")
  entityId    String   @map("entity_id")
  entityType  String   @map("entity_type") // 'post', 'user', 'comment', 'listing'
  reason      String
  status      String   @default("PENDING") // 'PENDING', 'RESOLVED', 'DISMISSED'
  resolvedBy  String?  @map("resolved_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
  @@map("reports")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String?  // 'android', 'ios', 'web'
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Post {
  id          String   @id @default(uuid())
  authorId    String   @map("author_id")
  content     String
  mediaUrls   String?  @map("media_urls") // JSON string of URLs
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  replyToId   String?  @map("reply_to_id")
  repostOfId  String?  @map("repost_of_id")
  likesCount  Int      @default(0) @map("likes_count")
  repostsCount Int     @default(0) @map("reposts_count")
  repliesCount Int     @default(0) @map("replies_count")
  isPinned    Boolean  @default(false) @map("is_pinned")
  status      String    @default("ACTIVE") // 'ACTIVE', 'PENDING', 'HIDDEN', 'REMOVED'
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author    User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo   Post?  @relation("Replies", fields: [replyToId], references: [id])
  replies   Post[] @relation("Replies")
  repostOf  Post?  @relation("Reposts", fields: [repostOfId], references: [id])
  reposts   Post[] @relation("Reposts")
  likes     Like[]
  poll      Poll?
  hashtags  Hashtag[]

  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

model Hashtag {
  id        String   @id @default(uuid())
  tag       String   @unique
  count     Int      @default(0)
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt DateTime @default(now()) @map("created_at")

  posts     Post[]

  @@index([count])
  @@index([lastUsedAt])
  @@map("hashtags")
}

model Poll {
  id        String   @id @default(uuid())
  postId    String   @unique @map("post_id")
  question  String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

model PollOption {
  id        String @id @default(uuid())
  pollId    String @map("poll_id")
  text      String
  voteCount Int    @default(0) @map("vote_count")
  order     Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id           String   @id @default(uuid())
  pollId       String   @map("poll_id")
  pollOptionId String   @map("poll_option_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  poll       Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollOption PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
  @@index([pollId])
  @@index([pollOptionId])
  @@index([userId])
  @@map("poll_votes")
}

model Like {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

// Marketplace Listings
model Listing {
  id          String    @id @default(uuid())
  sellerId    String    @map("seller_id")
  title       String
  description String?
  price       Float
  category    String
  condition   String
  isbn        String?
  images      String?   // JSON array
  location    String?   // Pickup location
  status      String    @default("active")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  favorites ListingFavorite[]
  bookmarks ListingBookmark[]

  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@map("listings")
}

model ListingFavorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("listing_favorites")
}

model ListingBookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("listing_bookmarks")
}

// Lost & Found
model LostFoundItem {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  type             String   // 'lost' or 'found'
  title            String
  description      String
  location         String
  images           String?  // JSON array
  securityQuestion String?  @map("security_question")
  securityAnswer   String?  @map("security_answer")
  status           String   @default("active")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("lost_found_items")
}

// Events
model Event {
  id          String      @id @default(uuid())
  organizerId String      @map("organizer_id")
  title       String
  description String
  location    String
  latitude    Float?
  longitude   Float?
  geofenceRadius Float?  @default(0) @map("geofence_radius") // in meters
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime    @map("ends_at")
  category    String
  imageUrl    String?     @map("image_url")
  images      String[]    @default([])
  entryFee    Float?      @default(0) @map("entry_fee")
  organizerName String?   @map("organizer_name")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  organizer User        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  rsvps     EventRsvp[]

  @@index([organizerId])
  @@index([startsAt])
  @@index([category])
  @@map("events")
}

model EventRsvp {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_rsvps")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // 'like', 'reply', 'repost', 'follow', 'system'
  title     String
  content   String?
  entityId  String?  @map("entity_id")
  entityType String? @map("entity_type") // 'post', 'user', 'event'
  isRead    Boolean  @default(false) @map("is_read")
  count     Int      @default(1)
  metadata  String?  // JSON string for actorIds etc
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// Direct Messaging
model Conversation {
  id           String    @id @default(uuid())
  participant1Id String   @map("participant1_id")
  participant2Id String   @map("participant2_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  messages Message[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String
  imageUrl       String?  @map("image_url")
  isRead         Boolean  @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

// Communities
model Community {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  name        String   
  description String?
  avatarUrl   String?  @map("avatar_url")
  bannerUrl   String?  @map("banner_url")
  category    String?
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner       User              @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  followers   CommunityFollow[]
  posts       CommunityPost[]
  links       CommunityLink[]

  @@index([ownerId])
  @@index([category])
  @@map("communities")
}

model CommunityFollow {
  id          String   @id @default(uuid())
  communityId String   @map("community_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@map("community_follows")
}

model CommunityPost {
  id          String   @id @default(uuid())
  communityId String   @map("community_id")
  authorId    String   @map("author_id")
  content     String
  mediaUrls   String?  @map("media_urls")
  likesCount  Int      @default(0) @map("likes_count")
  repliesCount Int     @default(0) @map("replies_count")
  replyToId   String?  @map("reply_to_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User      @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replyTo     CommunityPost?  @relation("CommunityPostReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     CommunityPost[] @relation("CommunityPostReplies")
  likes       CommunityPostLike[]

  @@index([communityId])
  @@index([authorId])
  @@map("community_posts")
}

model CommunityPostLike {
  id              String        @id @default(uuid())
  communityPostId String        @map("community_post_id")
  userId          String        @map("user_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  communityPost   CommunityPost @relation(fields: [communityPostId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityPostId, userId])
  @@index([communityPostId])
  @@index([userId])
  @@map("community_post_likes")
}

model CommunityLink {
  id          String   @id @default(uuid())
  communityId String   @map("community_id")
  platform    String   // 'whatsapp', 'twitter', 'facebook', 'instagram', 'telegram', 'discord', 'other'
  url         String
  label       String?
  createdAt   DateTime @default(now()) @map("created_at")

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@map("community_links")
}

// ============================================
// RESOURCE MANAGEMENT (University Study Materials)
// ============================================

// University Hierarchy: University > School > YearOfStudy > Course > Unit > Resource

model University {
  id          String       @id @default(uuid())
  name        String       @unique
  domain      String?      // e.g., "university.edu"
  logoUrl     String?      @map("logo_url")
  bannerUrl   String?      @map("banner_url")
  schools     School[]
  createdAt   DateTime     @default(now()) @map("created_at")
  
  @@map("universities")
}

// School/Faculty (e.g., School of Sciences, School of Medicine)
model School {
  id           String       @id @default(uuid())
  universityId String       @map("university_id")
  name         String       // e.g., "School of Sciences"
  code         String       // e.g., "SCI", "MED", "EDU"
  description  String?
  bannerUrl    String?      @map("banner_url") // Unsplash image URL
  color        String?      // Theme color (hex) for UI
  iconName     String?      @map("icon_name")  // Icon identifier
  orderIndex   Int          @default(0) @map("order_index")
  courses      Course[]     // School has many Courses (e.g., Computer Science)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  
  @@unique([universityId, code])
  @@index([universityId])
  @@map("schools")
}

// Year of Study within a Course (e.g., Year 1, Year 2, etc.)
model YearOfStudy {
  id          String     @id @default(uuid())
  courseId    String     @map("course_id")
  year        Int        // 1, 2, 3, 4, 5, 6 (for medicine, etc.)
  name        String     // "Year 1", "First Year", "Freshman"
  description String?
  units       Unit[]     // Year has many Units (e.g., CSC 311)
  createdAt   DateTime   @default(now()) @map("created_at")
  
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([courseId, year])
  @@index([courseId])
  @@map("years_of_study")
}

// Department (kept for organizational purposes, optional)
model Department {
  id           String     @id @default(uuid())
  universityId String     @map("university_id")
  name         String
  code         String     // e.g., "CS", "MATH"
  createdAt    DateTime   @default(now()) @map("created_at")
  
  @@unique([universityId, code])
  @@index([universityId])
  @@map("departments")
}

// Course (e.g., Computer Science, Medicine) - linked to School
model Course {
  id            String         @id @default(uuid())
  schoolId      String         @map("school_id")
  code          String         // e.g., "CS", "MED", "ENG"
  name          String         // e.g., "Computer Science"
  description   String?
  bannerUrl     String?        @map("banner_url")
  yearsOfStudy  YearOfStudy[]  // Course has years (1, 2, 3, 4)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("courses")
}

// Unit/Module (e.g., CSC 311) within a Year of Study
model Unit {
  id            String       @id @default(uuid())
  yearOfStudyId String       @map("year_of_study_id")
  code          String       // e.g., "CSC 311", "MATH 101"
  name          String       // e.g., "Data Structures and Algorithms"
  description   String?
  creditHours   Int?         @map("credit_hours")
  professorName String?      @map("professor_name")
  orderIndex    Int          @default(0) @map("order_index")
  resources     Resource[]
  createdAt     DateTime     @default(now()) @map("created_at")
  
  yearOfStudy   YearOfStudy  @relation(fields: [yearOfStudyId], references: [id], onDelete: Cascade)
  
  @@unique([yearOfStudyId, code])
  @@index([yearOfStudyId])
  @@map("units")
}

// Core Resource Model - Resources belong to Units
model Resource {
  id            String            @id @default(uuid())
  uploaderId    String            @map("uploader_id")
  unitId        String            @map("unit_id")  // Required: resource belongs to a unit
  title         String
  description   String?           @db.Text
  fileUrl       String            @map("file_url")
  fileType      String            @map("file_type")   // 'pdf', 'docx', 'pptx', 'image'
  fileSize      Int               @map("file_size")   // in bytes
  mimeType      String            @map("mime_type")
  semester      String?                               // e.g., "Fall 2025"
  resourceType  String            @map("resource_type") // 'lecture_notes', 'assignment', 'exam', 'textbook', 'other'
  professorName String?           @map("professor_name")
  isVerified    Boolean           @default(false)     @map("is_verified")
  isProcessed   Boolean           @default(false)     @map("is_processed") // RAG processing status
  upvoteCount   Int               @default(0)         @map("upvote_count")
  downloadCount Int               @default(0)         @map("download_count")
  viewCount     Int               @default(0)         @map("view_count")
  status        String            @default("active")  // 'active', 'pending', 'removed'
  metadata      String?           @db.Text            // JSON for parsed content metadata
  createdAt     DateTime          @default(now())     @map("created_at")
  updatedAt     DateTime          @updatedAt          @map("updated_at")
  
  uploader      User              @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  unit          Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  versions      ResourceVersion[]
  upvotes       ResourceUpvote[]
  comments      ResourceComment[]
  embeddings    ResourceEmbedding[]
  
  @@index([uploaderId])
  @@index([unitId])
  @@index([resourceType])
  @@index([semester])
  @@index([createdAt])
  @@index([upvoteCount])
  @@map("resources")
}

model ResourceVersion {
  id          String   @id @default(uuid())
  resourceId  String   @map("resource_id")
  version     Int
  fileUrl     String   @map("file_url")
  changeNote  String?  @map("change_note")
  createdAt   DateTime @default(now()) @map("created_at")
  
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  
  @@index([resourceId])
  @@map("resource_versions")
}

model ResourceUpvote {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([resourceId, userId])
  @@index([resourceId])
  @@index([userId])
  @@map("resource_upvotes")
}

model ResourceComment {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  userId     String   @map("user_id")
  content    String   @db.Text
  replyToId  String?  @map("reply_to_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  resource   Resource          @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo    ResourceComment?  @relation("ResourceCommentReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies    ResourceComment[] @relation("ResourceCommentReplies")
  
  @@index([resourceId])
  @@index([userId])
  @@map("resource_comments")
}

// RAG Embeddings Storage (for Pinecone metadata reference)
model ResourceEmbedding {
  id           String   @id @default(uuid())
  resourceId   String   @map("resource_id")
  pineconeId   String   @unique @map("pinecone_id") // Reference to Pinecone vector
  chunkIndex   Int      @map("chunk_index")
  pageNumber   Int?     @map("page_number")
  chunkText    String   @db.Text @map("chunk_text") // Original text for display
  createdAt    DateTime @default(now()) @map("created_at")
  
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  
  @@index([resourceId])
  @@index([pineconeId])
  @@map("resource_embeddings")
}

// Study Groups (Collaborative Folders)
model StudyGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  courseId    String?  @map("course_id")
  isPrivate   Boolean  @default(true) @map("is_private")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  members     StudyGroupMember[]
  
  @@index([courseId])
  @@map("study_groups")
}

model StudyGroupMember {
  id           String   @id @default(uuid())
  studyGroupId String   @map("study_group_id")
  userId       String   @map("user_id")
  role         String   @default("member") // 'owner', 'admin', 'member'
  joinedAt     DateTime @default(now()) @map("joined_at")
  
  studyGroup   StudyGroup @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  
  @@unique([studyGroupId, userId])
  @@index([studyGroupId])
  @@index([userId])
  @@map("study_group_members")
}
